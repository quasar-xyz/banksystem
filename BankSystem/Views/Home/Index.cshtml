@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    <a asp-controller="Home" asp-action="ViewClients" class="btn btn-primary btn-lg mt-4">View All Clients</a>
    @if (User.Identity.IsAuthenticated && User.IsInRole("Client"))
    {
       
        <a asp-controller="Home" asp-action="AccountBalance" class="btn btn-primary btn-lg mt-4">View Account Balance</a>
    }
</div>