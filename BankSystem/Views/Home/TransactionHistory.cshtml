@model List<BankSystem.Data.TABLES.Transaction>

@{
    ViewData["Title"] = "Transaction History";
}

<h1>Transaction History</h1>

<table class="table">
    <thead>
    <tr>
        <th>Date</th>
        <th>Amount</th>
        <th>Bank Code</th>
        <th>Variable Symbol</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var transaction in Model)
    {
        <tr>
            <td>@transaction.Date</td>
            <td>@transaction.Amount</td>
            <td>@transaction.BankCode</td>
            <td>@transaction.VariableSymbol</td>
        </tr>
    }
    </tbody>
</table>