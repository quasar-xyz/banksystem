@model IEnumerable<BankSystem.Data.Identity.ApplicationUser>

@{
    ViewData["Title"] = "Delete Clients";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Surname</th>
        <th>Email</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var client in Model)
    {
        <tr>
            <td>@client.Name</td>
            <td>@client.Surname</td>
            <td>@client.Email</td>
            <td>
                <form method="post" asp-action="DeleteClient" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@client.Id" />
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this client?');">
                        Delete Client
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
